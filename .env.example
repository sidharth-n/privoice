# Venice API key — create one at https://venice.ai/settings/api
# Only needed for the hosted slots (LLM_BACKEND=venice, STT_ENGINE=venice,
# TTS_ENGINE=venice). The fully local path needs no key and no network.
VENICE_API_KEY=

# Override only if you are pointing at a proxy or a different API version.
VENICE_BASE_URL=https://api.venice.ai/api/v1
